# Copiá este archivo como .env y completá los valores. El archivo .env NO se sube al repositorio.
PORT=3000
# Cadena de conexión de Neon (o de cualquier PostgreSQL). Ejemplo de formato:
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
# Texto largo y aleatorio para firmar las sesiones (mínimo 32 caracteres)
JWT_SECRET=
# URL del frontend publicado (para CORS). En desarrollo local puede quedar vacío.
FRONTEND_URL=
# true = el backend también sirve el frontend (solo para probar en local)
SERVE_FRONTEND=false
# Contraseñas iniciales de los usuarios que crea "npm run db:seed". Si las dejás vacías se generan al azar.
SEED_ADMIN_PASSWORD=
SEED_TECNICO_PASSWORD=
SEED_MEDICO_PASSWORD=
